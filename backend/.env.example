# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sih_rag

# Optional: overrides the POSTGRES_* fields above if set.
# DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/sih_rag

# --- Storage ---
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=50

# --- Chunking (Phase 2) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- PDF extraction / OCR (Phase 2) ---
OCR_TEXT_THRESHOLD=20
OCR_RENDER_DPI=200
# Windows: set this to your Tesseract install path if it's not on PATH,
# e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Embeddings (Phase 3) ---
EMBEDDING_DIM=384
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
# Optional: override where the model is cached on disk.
EMBEDDING_CACHE_DIR=
# Set true before an offline demo (once the model is already cached).
EMBEDDING_OFFLINE_MODE=false

# --- Reranker (Phase 6) ---
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- LLM (Phase 7/8) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
