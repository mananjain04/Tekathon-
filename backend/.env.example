# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sih_rag

# Optional: overrides the POSTGRES_* fields above if set.
# DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/sih_rag

# --- Storage ---
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=50

# --- Chunking (Phase 2) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- PDF extraction / OCR (Phase 2) ---
OCR_TEXT_THRESHOLD=20
OCR_RENDER_DPI=200
# Windows: set this to your Tesseract install path if it's not on PATH,
# e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Embeddings (Phase 3) ---
EMBEDDING_DIM=384
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
# Optional: override where the model is cached on disk.
EMBEDDING_CACHE_DIR=
# Set true before an offline demo (once the model is already cached).
EMBEDDING_OFFLINE_MODE=false

# --- Reranker (Phase 4B) ---
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=16
# Optional: override where the cross-encoder model is cached on disk.
RERANKER_CACHE_DIR=
# Set true before an offline demo (once the model is already cached).
RERANKER_OFFLINE_MODE=false

# --- Retrieval (Phase 4A: vector search; Phase 4B: + re-ranking) ---
RETRIEVAL_TOP_K_DEFAULT=10
RETRIEVAL_TOP_K_MAX=100

# --- Local LLM provider ---
# Supported values: "ollama" (recommended, no compilation needed on Windows)
#                   "llama_cpp" (GGUF via llama-cpp-python, see docs/PHASE5.md)
LLM_PROVIDER=ollama

# --- Ollama provider (LLM_PROVIDER=ollama) ---
# URL of the local Ollama server. NEVER set to a cloud/external URL.
# After `ollama pull <model>`, the full pipeline works with no Internet access.
OLLAMA_BASE_URL=http://localhost:11434
# Model tag to use. Must be pulled first: `ollama pull qwen2.5:7b`
# Other options: llama3.1:8b, mistral:7b, gemma2:9b, etc.
OLLAMA_MODEL=qwen2.5:7b
# Request timeout in seconds. Increase on slower hardware.
OLLAMA_TIMEOUT=120.0

# --- llama.cpp / GGUF provider (LLM_PROVIDER=llama_cpp) ---
# See docs/PHASE5.md for Windows installation prerequisites.
# Absolute path to a local GGUF model file, e.g.:
# LLM_MODEL_PATH=C:\models\Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# Left empty, the backend starts up fine but /api/rag/query returns a clear
# error until this is set and the file exists. See backend/docs/PHASE5.md.
LLM_MODEL_PATH=
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
# GPU layers to offload (llama.cpp n_gpu_layers). 0 = CPU-only.
LLM_GPU_LAYERS=0
# Leave empty to let llama.cpp choose a sensible thread count.
LLM_THREADS=
